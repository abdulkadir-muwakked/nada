{
  "expo": {
    "name": "nada",
    "slug": "nada",
    "version": "1.1",
    "orientation": "portrait",
    "icon": "./assets/icon/nada-icon-1024.png",
    "scheme": "nada",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.mouket.nada",
      "appleTeamId": "A6V3HV6852"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/nada-icon-1024.png",
        "backgroundColor": "#1a1a2e"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.mouket.nada",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "permissions": ["VIBRATE"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon/nada-icon-1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/nada-icon-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a1a2e"
        }
      ],
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-1609492440808781~3500829830",
          "androidAppId": "ca-app-pub-1609492440808781~3500829830"
        }
      ],
      "expo-notifications",
      "expo-background-task",
      "expo-dev-client"
    ],
    "extra": {
      "eas": {
        "projectId": "447f8604-d80a-4cb6-9c75-a451a142620d"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true
  }
}
